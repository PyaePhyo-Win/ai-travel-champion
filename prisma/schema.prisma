// AI Travel Champion — Prisma schema (SQLite / Turso libSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("PRISMA_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  image        String?
  passwordHash String?
  preferences  Json?
  createdAt    DateTime  @default(now())
  accounts     Account[]
  sessions     Session[]
  trips        Trip[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Trip {
  id               String   @id @default(cuid())
  userId           String?
  isDemo           Boolean  @default(false)
  status           String   @default("planning")
  inputText        String   @default("")
  extractedDetails Json?
  constraints      Json?
  recommendations  Json?
  feedbackHistory  Json?
  itinerary        Json?
  currentStep      Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String
  emoji     String
  tagline   String?
  category  String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}
