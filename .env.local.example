# Turso (libSQL) — your hosted database URL + auth token
# Format: libsql://<db-name>-<org>.turso.io?authToken=<token>
DATABASE_URL=libsql://your-db.turso.io?authToken=your_auth_token_here

# Auth.js (NextAuth v5)
AUTH_SECRET=replace_me_with_a_long_random_string
AUTH_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Map (MapLibre + Stadia Maps - no token required)
NEXT_PUBLIC_MAP_STYLE=https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
